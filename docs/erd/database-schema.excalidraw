": "1", "fontSize": 17, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "text104", "type": "text", "x": 1173.0, "y": 536.0, "width": 10.2, "height": 21.25, "angle": 0, "strokeColor": "#c2410c", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 793950893, "version": 1, "versionNonce": 675359206, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "N", "originalText": "N", "fontSize": 17, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "text105", "type": "text", "x": 1058.8, "y": 561.0, "width": 62.4, "height": 16.25, "angle": 0, "strokeColor": "#495057", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 594779093, "version": 1, "versionNonce": 211086681, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "entry_id", "originalText": "entry_id", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "text106", "type": "text", "x": 0, "y": -210, "width": 345.59999999999997, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 737632717, "version": 1, "versionNonce": 416837247, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Time Capsule - ERD", "originalText": "Time Capsule - ERD", "fontSize": 32, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "text107", "type": "text", "x": 0, "y": -165, "width": 1026.0, "height": 18.75, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 947244036, "version": 1, "versionNonce": 518097836, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "PK = Primary Key | FK = Foreign Key | UQ = Unique | ? = nullable | purple = Enum type | orange 1 / N = cardinality", "originalText": "PK = Primary Key | FK = Foreign Key | UQ = Unique | ? = nullable | purple = Enum type | orange 1 / N = cardinality", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "rectangle108", "type": "rectangle", "x": 0, "y": 830, "width": 640, "height": 230, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 648039931, "version": 1, "versionNonce": 84286384, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text109", "type": "text", "x": 20, "y": 844, "width": 60.0, "height": 25.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 452536250, "version": 1, "versionNonce": 50897050, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Enums", "originalText": "Enums", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "text110", "type": "text", "x": 20, "y": 884, "width": 513.0, "height": 112.5, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 111497011, "version": 1, "versionNonce": 117088613, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "CapsuleType:        PERSONAL | GROUP\nCapsuleStatus:      DRAFT | COLLECTING | OPEN | CANCELLED\nMemberRole:         OWNER | MEMBER\nInvitationStatus:   ACTIVE | REVOKED\n                    (EXPIRED is computed, not stored)\nAttachmentType:     IMAGE | VIDEO | AUDIO | DOCUMENT", "originalText": "CapsuleType:        PERSONAL | GROUP\nCapsuleStatus:      DRAFT | COLLECTING | OPEN | CANCELLED\nMemberRole:         OWNER | MEMBER\nInvitationStatus:   ACTIVE | REVOKED\n                    (EXPIRED is computed, not stored)\nAttachmentType:     IMAGE | VIDEO | AUDIO | DOCUMENT", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "rectangle111", "type": "rectangle", "x": 680, "y": 830, "width": 860, "height": 370, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#fff9db", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 41550023, "version": 1, "versionNonce": 550137879, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text112", "type": "text", "x": 700, "y": 844, "width": 264.0, "height": 25.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 273995993, "version": 1, "versionNonce": 255987775, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Business Rules & Notes", "originalText": "Business Rules & Notes", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "text113", "type": "text", "x": 700, "y": 884, "width": 774.0, "height": 243.75, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 794384975, "version": 1, "versionNonce": 756536433, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "- The Capsule owner is also a member with role OWNER; owner_id must match that member.\n- Creating a Capsule automatically creates the OWNER membership.\n- Each user can join a specific capsule only once: UNIQUE(capsule_id, user_id).\n- Only capsule members can create entries (every entry belongs to a Capsule_Member).\n- An entry may have text only, attachments only, or both (text is nullable).\n- Capsule content stays hidden until opens_at; opens_at may be NULL only in DRAFT.\n- No new members or content after the capsule opens.\n- Opening is one-way: an OPEN capsule can never return to COLLECTING.\n- Invitation expiry is computed from expires_at vs. server time (not stored).\n- A link is unusable if REVOKED, expired, or usage_count reaches max_uses.\n  usage_count starts at 0; max_uses NULL = unlimited; revoking keeps existing members.\n- Joining via link (usage_count + member creation) runs in one DB transaction.\n- The backend enforces all authorization and lifecycle rules.", "originalText": "- The Capsule owner is also a member with role OWNER; owner_id must match that member.\n- Creating a Capsule automatically creates the OWNER membership.\n- Each user can join a specific capsule only once: UNIQUE(capsule_id, user_id).\n- Only capsule members can create entries (every entry belongs to a Capsule_Member).\n- An entry may have text only, attachments only, or both (text is nullable).\n- Capsule content stays hidden until opens_at; opens_at may be NULL only in DRAFT.\n- No new members or content after the capsule opens.\n- Opening is one-way: an OPEN capsule can never return to COLLECTING.\n- Invitation expiry is computed from expires_at vs. server time (not stored).\n- A link is unusable if REVOKED, expired, or usage_count reaches max_uses.\n  usage_count starts at 0; max_uses NULL = unlimited; revoking keeps existing members.\n- Joining via link (usage_count + member creation) runs in one DB transaction.\n- The backend enforces all authorization and lifecycle rules.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "rectangle_refresh_outer", "type": "rectangle", "x": 1600, "y": 0, "width": 500, "height": 278, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 224336681, "version": 1, "versionNonce": 1643316076, "isDeleted": false, "boundElements": [{"type": "arrow", "id": "arrow_user_refresh"}], "updated": 1, "link": null, "locked": false}, {"id": "rectangle_refresh_header", "type": "rectangle", "x": 1600, "y": 0, "width": 420, "height": 44, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1510273682, "version": 1, "versionNonce": 411385467, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "text_refresh_title", "type": "text", "x": 1614,