NODE_ENV=development
PORT=3000

JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_ROUNDS=12

REFRESH_TOKEN_COOKIE_NAME=memora_refresh
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAME_SITE=lax
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-gmail-address@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM="Memora <your-gmail-address@gmail.com>"
FRONTEND_URL=http://localhost:5173
MAX_CAPSULE_MEMBERS=50
INVITATION_RETENTION_DAYS=30
UPLOADS_DIR=./uploads
MAX_ATTACHMENT_IMAGE_SIZE_MB=10
MAX_ATTACHMENT_DOCUMENT_SIZE_MB=20
MAX_ATTACHMENT_AUDIO_SIZE_MB=30
MAX_ATTACHMENT_VIDEO_SIZE_MB=100

# Used for commands run on the host against the published PostgreSQL port.
DATABASE_URL=postgresql://memora:change_me@localhost:5433/memora_db?schema=public

POSTGRES_USER=memora
POSTGRES_PASSWORD=change_me
POSTGRES_DB=memora_db
